# Адрес, куда отправляются заявки с формы регистрации (Formspree, Google Apps Script, Getform и т.п.)
# Без него форма работает в демо-режиме.
NEXT_PUBLIC_FORM_ENDPOINT=

# Куда приходят отзывы после конференции (форма на главной и на /feedback/).
# Например, Formspree: https://formspree.io/f/xxxxxxx — отзывы будут приходить на почту.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=
